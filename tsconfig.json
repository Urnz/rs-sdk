{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["*.ts", "agent-skills/**/*.ts", "agent-state/**/*.ts", "character-attributes/**/*.ts", "crime-cases/**/*.ts", "crime-checkpoints/**/*.ts", "crime-heat/**/*.ts", "crime-metrics/**/*.ts", "crime-reintegration/**/*.ts", "fencing-market/**/*.ts", "food-loop/**/*.ts", "housing/**/*.ts", "item-lifecycle/**/*.ts", "item-provenance/**/*.ts", "item-transformation/**/*.ts", "land-construction/**/*.ts", "llm-runtime/**/*.ts", "needs/**/*.ts", "population-lifecycle/**/*.ts", "population-health/**/*.ts", "population-estate/**/*.ts", "sale-channel-policy/**/*.ts", "society-minimum/**/*.ts", "society-integrity/**/*.ts", "society-metrics/**/*.ts", "society-integration/**/*.ts", "scripts/society-integration-fixture.ts", "scripts/integration-native-bootstrap.ts", "external-trade/**/*.ts", "economic-dependency/**/*.ts", "society-experiments/**/*.ts", "scripts/run-society-experiment.ts", "scripts/run-strategic-acceptance.ts", "production-workflow/evidence.ts", "scripts/report-economic-dependencies.ts", "scripts/report-self-sufficiency.ts", "simulation-clock/**/*.ts", "world-genesis/**/*.ts", "server/gateway/**/*.ts", "sdk/**/*.ts"],
  "exclude": ["server/engine", "server/webclient", "node_modules"],
  "files": ["scripts/report-society-evaluation.ts", "scripts/society-benchmark.ts", "server/control-plane/main.ts", "server/control-plane/bootstrap-account.ts", "server/control-plane/import-tls.ts", "server/control-plane/readiness.ts", "server/control-plane/test/security.test.ts", "server/control-plane/test/security-browser.test.ts", "server/control-plane/windows-test/tls.test.ts", "server/control-plane/managed-worker.ts", "server/control-plane/test/accounts.test.ts", "server/control-plane/test/registry.test.ts", "server/control-plane/test/lifecycle.test.ts", "server/control-plane/test/managed-runtime.test.ts", "server/control-plane/test/maintenance.test.ts", "server/control-plane/test/service.test.ts", "server/control-plane/test/browser.test.ts", "server/control-plane/windows-test/process.test.ts", "server/control-plane/windows-test/runtime-leases.test.ts"]
