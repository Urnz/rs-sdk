{
  "schemaVersion": 1,
  "id": "procedure.thieving.container-theft",
  "version": "1.0.0",
  "name": "Steal from one configured container",
  "description": "Attempt one coordinate-bound chest or container theft through the existing Thieving mechanics and retain observable inventory, XP, target and game-message evidence. Ownership is resolved separately by a trusted domain adapter.",
  "status": "verified",
  "tags": ["procedure", "thieving", "container"],
  "parameters": {
    "target-name": { "type": "string", "description": "Exact display name of the configured container.", "required": true },
    "target-x": { "type": "number", "description": "Exact world X coordinate.", "required": true, "minimum": 0, "maximum": 16383 },
    "target-z": { "type": "number", "description": "Exact world Z coordinate.", "required": true, "minimum": 0, "maximum": 16383 },
    "minimum-level": { "type": "number", "description": "Minimum reviewed Thieving level.", "required": true, "minimum": 1, "maximum": 99 }
  },
  "provenance": {
    "authorKind": "human",
    "authorId": "agent-society-rs",
    "createdAt": "2026-09-27T19:30:00.000Z",
    "derivedFrom": { "id": "procedure.thieving.container-theft", "version": "0.1.0" },
    "notes": "Manually promoted after reviewed live engine run 727c2dc2-97bf-492e-b9b3-f3d66cd6b6c8 with recognition, report and restart replay in the frozen Phase 22.1 acceptance bundle."
  },
  "sharing": { "visibility": "shared" },
  "limits": { "timeoutMs": 30000, "maxOperations": 1 },
  "preconditions": [{
    "condition": "skill-level-at-least",
    "arguments": { "skill": "Thieving", "level": { "parameter": "minimum-level" } }
  }],
  "steps": [{
    "kind": "operation",
    "id": "steal-container",
    "operation": "thieve-container",
    "arguments": {
      "name": { "parameter": "target-name" },
      "match": "exact",
      "option": 2,
      "x": { "parameter": "target-x" },
      "z": { "parameter": "target-z" },
      "timeoutMs": 15000
    }
  }]
}
