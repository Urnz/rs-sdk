      "steps": [
        {
          "kind": "operation",
          "id": "mine-copper-rock",
          "operation": "gather-loc",
          "arguments": { "name": "rocks copper ore", "match": "exact", "option": "mine", "item": "copper ore", "skill": "Mining", "timeoutMs": 15000 },
          "maxAttempts": 3
