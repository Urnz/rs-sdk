    {
      "id": "minimum-assessor",
      "status": "blocked",
      "reason": "The17/8 assessor, work/tool lower bounds and applied-founder/death upper bounds exist. Continuous mortality/boundaries, needs/food/housing/capacity histories, complete request denominators and eight native integrity adapters remain incomplete."
    },
    {
      "id": "tool-unusable-demand-coverage",
      "status": "blocked",
      "reason": "Exact executor→SDK→typed native dispatch and selected-cohort raw Mining rejection are implemented. Complete high-level request denominators and a selected C07 watermark are still unproven; an empty queue or idle/offline cannot establish zero demand."
    },
    {
      "id": "legal-housing-exposure",
      "status": "unverified",
      "reason": "Two tenant slots and current rent/sleep receipts do not attest95% legal housing access for every founder; full ownership/access history is required."
    },
    {
      "id": "clock-ratio",
      "status": "blocked",
      "reason": "Accelerated needs exposure must be validated against actual content ticks, work credit, travel, harvest and meal timing before reuse."
    },
    {
      "id": "selected-baseline",
      "status": "unverified",
      "reason": "No active world selected, frozen founder roster or exact expanded baseline/result pin prepared for C07."
    },
    {
      "id": "native-regression",
      "status": "unverified",
      "reason": "Exact SI-A14 regression belongs after the cheap NO-GO blockers are resolved, before an approved long run."
    },
    {
      "id": "run-approval-and-budget",
      "status": "unapproved",
      "reason": "No new long-run/provider authority; B06 permission is scoped to its earlier trial."
    }
