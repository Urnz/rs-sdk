  "id": "procedure.food.gather-lobster",
  "name": "Gather one native lobster",
  "description": "Attempts one bounded native lobster gathering action at the configured Musa Point source; only a correlated native receipt proves success.",
  "parameters": {},
  "limits": {
    "timeoutMs": 15000,
    "maxOperations": 1
  },
  "preconditions": [
    {
      "condition": "inventory-free-slots-at-least",
      "arguments": {
        "slots": 1
      }
    },
    {
      "condition": "skill-level-at-least",
      "arguments": {
        "skill": "Fishing",
        "level": 40
      }
    }
  ],
  "steps": [
    {
      "kind": "operation",
      "id": "gather",
      "operation": "food-gather",
      "arguments": {
        "item": "Raw lobster",
        "itemId": 377,
        "amount": 1,
        "sourceId": "musa-point-lobster",
        "timeoutMs": 10000
      }
    }
  ]
