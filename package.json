{
  "name": "server",
  "private": true,
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun run typecheck:webclient && bun run test",
    "docs:api": "bun sdk/generate-api-docs.ts",
    "docs:api:check": "bun sdk/generate-api-docs.ts --check",
    "fetch-collision-data": "bun sdk/fetch-collision-data.ts",
    "format:check": "pwsh -NoProfile -File scripts/check-format.ps1",
    "local:start": "pwsh -NoProfile -File scripts/start-local.ps1",
    "local:status": "pwsh -NoProfile -File scripts/status-local.ps1",
    "local:stop": "pwsh -NoProfile -File scripts/stop-local.ps1",
    "skill:run": "bun agent-skills/run.ts",
    "skill:verify": "bun agent-skills/verify.ts",
    "skill:experiment": "bun agent-skills/experiment.ts",
    "test": "bun test agent-skills/test sdk/test server/gateway/admin server/engine/src/mods/DiminishingXp.test.ts server/engine/src/mods/WorldMods.test.ts server/webclient/src/bot server/webclient/src/util server/webclient/src/lite",
    "test:integration": "pwsh -NoProfile -File scripts/status-local.ps1 -Json",
    "test:powershell": "pwsh -NoProfile -File scripts/test-powershell.ps1",
    "test:quick": "bun test agent-skills/test sdk/test server/gateway/admin server/engine/src/mods/DiminishingXp.test.ts server/engine/src/mods/WorldMods.test.ts server/webclient/src/bot server/webclient/src/util server/webclient/src/lite",
    "test:phase7": "pwsh -NoProfile -File scripts/test-phase7-mod-framework.ps1 -SkipLive",
    "test:phase7:live": "pwsh -NoProfile -File scripts/test-phase7-mod-framework.ps1",
    "test:skills": "bun test agent-skills/test",
    "test:smoke": "pwsh -NoProfile -File scripts/smoke-local.ps1",
    "typecheck": "tsc --noEmit",
    "typecheck:webclient": "tsc --noEmit -p server/webclient/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "puppeteer": "^24.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.3",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "open": "^11.0.0"
  }
}
