{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["*.ts", "agent-skills/**/*.ts", "agent-state/**/*.ts", "character-attributes/**/*.ts", "crime-cases/**/*.ts", "crime-checkpoints/**/*.ts", "crime-heat/**/*.ts", "crime-metrics/**/*.ts", "crime-reintegration/**/*.ts", "fencing-market/**/*.ts", "food-loop/**/*.ts", "housing/**/*.ts", "item-lifecycle/**/*.ts", "item-provenance/**/*.ts", "item-transformation/**/*.ts", "land-construction/**/*.ts", "llm-runtime/**/*.ts", "needs/**/*.ts", "population-lifecycle/**/*.ts", "population-health/**/*.ts", "population-estate/**/*.ts", "sale-channel-policy/**/*.ts", "society-minimum/**/*.ts", "society-integrity/**/*.ts", "society-metrics/**/*.ts", "external-trade/**/*.ts", "economic-dependency/**/*.ts", "society-experiments/**/*.ts", "scripts/run-society-experiment.ts", "production-workflow/evidence.ts", "scripts/report-economic-dependencies.ts", "scripts/report-self-sufficiency.ts", "simulation-clock/**/*.ts", "world-genesis/**/*.ts", "server/gateway/**/*.ts", "sdk/**/*.ts"],
  "exclude": ["server/engine", "server/webclient", "node_modules"],
  "files": ["scripts/report-society-evaluation.ts", "scripts/society-benchmark.ts"]
}
