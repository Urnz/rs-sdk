{
  "schemaVersion": 1,
  "id": "mining.varrock-east.copper-to-general-store",
  "version": "1.0.0",
  "name": "Varrock east copper to general store",
  "description": "Mine a bounded amount of copper ore at Varrock east, then sell every carried copper ore to the Varrock General Store. Development draft requiring isolated live verification.",
  "status": "verified",
