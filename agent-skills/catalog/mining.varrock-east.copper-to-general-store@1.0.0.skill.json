    {
      "kind": "operation",
      "id": "sell-copper-ore",
      "operation": "sell-to-shop",
      "arguments": { "name": "Copper ore", "match": "exact", "amount": -1 },
      "maxAttempts": 2
    },
    { "kind": "operation", "id": "close-shop", "operation": "close-shop", "arguments": {} }
  ]
